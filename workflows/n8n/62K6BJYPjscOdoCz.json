    {
      "id": "Plan_batch_discovery",
      "name": "Plan batch discovery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        700
      ],
      "parameters": {
        "jsCode": "const state=JSON.parse($('Read batch registry').first().json.stateJson);\nif(state.schemaVersion!==1)throw new Error('Unsupported batch registry');\nconst files=$('Find one Input image').all().map(i=>i.json).filter(f=>f.id&&/^image\\/(jpeg|png|webp)$/.test(f.mimeType)&&Number(f.size)<=20971520&&Number(f.imageMediaMetadata?.width)>0&&Number(f.imageMediaMetadata?.height)>0);\nconst jobs=$('Read job ledger for batches').all().map(i=>i.json).filter(j=>j.fileId);\nconst listing=$input.first().json;if(listing.nextPageToken)throw new Error('Batch folder listing exceeds 1000; retain coordinator');\nconst folders=listing.files||[];const now=Date.now();const gap=300000;\nconst crossed=state.files['PRIVATE_RESOURCE_a14bf54dd8cb'];if(crossed&&crossed.batchNo===1){const target=state.batches.find(b=>b.number===2);if(!target||Math.abs(Date.parse(target.lastUploadAt)-Date.parse('2026-10-16T03:58:10.541Z'))>300000)throw new Error('Cannot reconcile deployment-crossing upload');crossed.batchNo=2;crossed.uploadedAt='2026-10-16T03:58:10.541Z';crossed.relocated=false;const original=state.batches.find(b=>b.number===1);original.completedAt=null;}\n\nconst iso=t=>new Date(t).toISOString();\nfor(const f of files.sort((a,b)=>Date.parse(a.createdTime)-Date.parse(b.createdTime)||a.id.localeCompare(b.id))){\n if(state.files[f.id])continue;\n const t=Date.parse(f.createdTime);if(!Number.isFinite(t))throw new Error('Missing Drive upload time');\n let batch;\n if(state.bootstrap&&t>=Date.parse(state.bootstrapCutoff)&&t<=Date.parse('2026-10-16T03:09:00Z')){batch=state.batches.find(b=>b.number===1);}\n else {\n   batch=state.batches.find(b=>!b.completedAt&&t>=Date.parse(b.lastUploadAt)-gap&&t<Date.parse(b.lastUploadAt)+gap);\n   const latest=state.batches.at(-1);\n   if(!batch&&latest&&!latest.completedAt&&!latest.closedAt&&t-Date.parse(latest.lastUploadAt)<gap)batch=latest;\n   if(!batch){const number=Math.max(0,...state.batches.map(b=>b.number))+1;batch={number,label:'Batch_'+String(number).padStart(3,'0'),lastUploadAt:iso(t),closedAt:null,completedAt:null,folderId:null};state.batches.push(batch);}\n }\n if(t>Date.parse(batch.lastUploadAt)){batch.lastUploadAt=iso(t);batch.closedAt=null;}\n state.files[f.id]={batchNo:batch.number,uploadedAt:iso(t),outputFileId:null,relocated:false};\n}\nif(state.bootstrap){for(const j of jobs.filter(j=>[\"PRIVATE_RESOURCE_1b53766cd0a0\",\"PRIVATE_RESOURCE_56944ac30656\",\"PRIVATE_RESOURCE_12407eacd669\",\"PRIVATE_RESOURCE_f9e9fc6a493e\",\"PRIVATE_RESOURCE_09e21e4acea2\",\"PRIVATE_RESOURCE_a6bda22aa3b0\",\"PRIVATE_RESOURCE_a58af9943ee0\",\"PRIVATE_RESOURCE_59e670142dfd\",\"PRIVATE_RESOURCE_cbc84480a3bd\",\"PRIVATE_RESOURCE_e9b216df18ab\",\"PRIVATE_RESOURCE_0a61c8790a14\"].includes(j.fileId))){if(!state.files[j.fileId])state.files[j.fileId]={batchNo:1,uploadedAt:'2026-10-16T03:08:48.407Z',outputFileId:j.outputFileId||null,relocated:false};}state.bootstrap=false;}\nfor(const [fileId,f]of Object.entries(state.files)){const j=jobs.find(j=>j.fileId===fileId);if(j?.outputFileId)f.outputFileId=j.outputFileId;}\nfor(const b of state.batches){\n if(now-Date.parse(b.lastUploadAt)>=gap&&!b.closedAt)b.closedAt=iso(Date.parse(b.lastUploadAt)+gap);\n const found=folders.filter(f=>f.name===b.label&&f.mimeType==='application/vnd.google-apps.folder'&&!f.trashed);\n if(found.length>1)throw new Error('Duplicate batch folders: '+b.label);\n if(found.length===1){if(b.folderId&&b.folderId!==found[0].id)throw new Error('Batch folder changed');b.folderId=found[0].id;}\n if(b.folderId&&!found.length)throw new Error('Persisted batch folder missing from Output');\n}\nif(JSON.stringify(state).length>1000000)throw new Error('Batch registry requires archival; retain coordinator');\nreturn [{json:{state,files,jobs,missingFolders:state.batches.filter(b=>!b.folderId).map(b=>({number:b.number,label:b.label}))}}];"
      }
    },
