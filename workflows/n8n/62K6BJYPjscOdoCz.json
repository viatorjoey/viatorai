    {
      "id": "Finalize_batch_folders",
      "name": "Finalize batch folders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        960
      ],
      "parameters": {
        "jsCode": "const p=$('Plan batch discovery').first().json;const state=JSON.parse(JSON.stringify(p.state));\nfor(const r of $input.all().map(i=>i.json).filter(x=>!x.skipFolder)){\n const b=state.batches.find(b=>b.label===r.name);\n if(!b||!r.id||r.mimeType!=='application/vnd.google-apps.folder'||!r.parents?.includes('PRIVATE_RESOURCE_4f5dd7e4c7ae'))throw new Error('Batch folder creation not verified');\n b.folderId=r.id;\n}\nif(state.batches.some(b=>!b.folderId))throw new Error('Batch folder unresolved');\nreturn [{json:{...p,state}}];"
