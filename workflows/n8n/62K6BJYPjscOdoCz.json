      "name": "Verify completed output ownership",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        1220
      ],
      "parameters": {
        "jsCode": "const plans=$('Plan completed output organization').all();const managed=$('Finalize batch folders').first().json.state.batches.map(b=>b.folderId);return $input.all().map((item,i)=>{const f=item.json,p=plans[i]?.json;if(!p||f.id!==p.outputFileId||f.trashed||Number(f.size)<1024||!f.parents?.some(x=>x==='PRIVATE_RESOURCE_4f5dd7e4c7ae'||managed.includes(x)))throw new Error('Output ownership/parent verification failed');return {json:{...p,removeParents:f.parents.filter(x=>x!==p.folderId&&(x==='PRIVATE_RESOURCE_4f5dd7e4c7ae'||managed.includes(x))).join(',')},pairedItem:{item:i}};});"
