    {
      "id": "Plan_output_migrations",
      "name": "Plan completed output organization",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1480,
        960
      ],
      "parameters": {
        "jsCode": "const p=$input.first().json;const a=[];\nfor(const [sourceId,f] of Object.entries(p.state.files)){const j=p.jobs.find(j=>j.fileId===sourceId);if(f.relocated||j?.status!=='cleanup_verified'||!j.outputFileId)continue;\n const b=p.state.batches.find(b=>b.number===f.batchNo);a.push({sourceId,outputFileId:j.outputFileId,folderId:b.folderId,desiredName:b.label+'_'+sourceId+'.mp4'});}\nreturn a.length?a.map(json=>({json})):[{json:{skipMigration:true}}];"
