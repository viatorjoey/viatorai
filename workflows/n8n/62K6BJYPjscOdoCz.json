    {
      "id": "Finish_batch_reconciliation",
      "name": "Verify batch completion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        1220
      ],
      "parameters": {
        "jsCode": "const p=$('Finalize batch folders').first().json;const state=JSON.parse(JSON.stringify(p.state));const plans=$('Plan completed output organization').all();\nfor(const [i,r]of $input.all().entries()){const f=r.json;if(f.skipMigration)continue;const job=plans[i]?.json;\n if(!job||f.id!==job.outputFileId||f.name!==job.desiredName||!f.parents?.includes(job.folderId)||Number(f.size)<1024)throw new Error('Organized output verification failed');\n state.files[job.sourceId].relocated=true;state.files[job.sourceId].outputFileId=f.id;\n}\nconst now=new Date().toISOString();\nfor(const b of state.batches){const members=Object.entries(state.files).filter(([,f])=>f.batchNo===b.number);const ok=members.length>0&&members.every(([id,f])=>{const j=p.jobs.find(j=>j.fileId===id);return j?.status==='cleanup_verified'&&j.outputFileId&&f.relocated&&f.outputFileId===j.outputFileId;});b.photoCount=members.length;b.completedCount=members.filter(([id,f])=>p.jobs.some(j=>j.fileId===id&&j.status==='cleanup_verified')&&f.relocated).length;if(b.closedAt&&ok&&!b.completedAt)b.completedAt=now;}\nreturn [{json:{stateJson:JSON.stringify(state),state,files:p.files,jobs:p.jobs}}];"
