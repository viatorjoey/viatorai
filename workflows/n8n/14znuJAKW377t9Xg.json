      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q=$input.first().json,s=$('Start cleanup').first().json,stats=$('Read stable VRAM').first().json;if(Date.now()-s.cleanupStartedAt>180000)throw new Error('VRAM release not confirmed within 180 seconds; retain lock');if(!Array.isArray(q.queue_running)||!Array.isArray(q.queue_pending)||q.queue_running.length||q.queue_pending.length)throw new Error('Queue no longer idle during cleanup; retain lock');const d=stats?.devices?.filter(x=>x.type==='cuda');if(!d?.length)throw new Error('Missing CUDA memory telemetry; retain lock');const released=d.every(x=>Number.isFinite(x.torch_vram_total)&&Number.isFinite(x.torch_vram_free)&&x.torch_vram_total>=0&&x.torch_vram_free>=0&&x.torch_vram_free<=x.torch_vram_total&&x.torch_vram_total<=134217728&&x.torch_vram_total-x.torch_vram_free<=16777216);if(!released)throw new Error('VRAM grew during stable confirmation; retain lock');return [{json:{...s,cleanupReady:released,cleanupReadAt:Date.now(),before:$('VRAM before cleanup').first().json.devices,after:stats.devices}}];"
      }
