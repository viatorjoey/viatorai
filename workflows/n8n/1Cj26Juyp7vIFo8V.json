      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const result=[]; for (const item of $input.all()) { for (const [id,h] of Object.entries(item.json||{})) { const p=h.prompt?.[2] || {}; const classes=Object.values(p).map(n=>n.class_type).filter(Boolean); result.push({json:{id,completed:h.status?.completed,success:h.status?.status_str,classes:[...new Set(classes)].slice(0,35),nodeCount:classes.length,hasOutputs:!!h.outputs && Object.keys(h.outputs).length>0}}); } } return result.length?result:[{json:{message:'No recent history'}}];"
      }
    }
