    {
      "id": "gate",
      "name": "Detect newly completed LTX video",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const history=$('Recent LTX History').first().json||{};\nconst queue=$('Current ComfyUI Queue').first().json||{};\nconst state=$getWorkflowStaticData('global');\nconst idle=Array.isArray(queue.queue_running)&&Array.isArray(queue.queue_pending)&&queue.queue_running.length===0&&queue.queue_pending.length===0;\nif(!idle)return [];\nconst records=Object.entries(history).filter(([id,h])=>{\n if(h?.status?.completed!==true||h?.status?.status_str!=='success')return false;\n const nodes=Object.values(h?.prompt?.[2]||{});\n const classes=nodes.map(n=>String(n?.class_type||''));\n const isLtx=classes.some(t=>/LTXV|LTX2|LTX/i.test(t))||nodes.some(n=>/ltx[-_]2[.\\d-]*/i.test(String(n?.inputs?.unet_name||'')));\n const saved=classes.includes('SaveVideo')||classes.includes('VHS_VideoCombine');\n return isLtx&&saved&&h.outputs&&Object.keys(h.outputs).length>0;\n}).map(([id,h])=>({id,completedMs:Math.max(0,...(h.status.messages||[]).filter(m=>m[0]==='execution_success').map(m=>Number(m[1]?.timestamp||0)))}));\nconst allIds=records.map(x=>x.id);\nif(state.cleanupTrackerVersion!==2){\n state.cleanupTrackerVersion=2;\n state.processedIds=allIds.slice(-200);\n return [];\n}\nconst processed=new Set(Array.isArray(state.processedIds)?state.processedIds:[]);\nconst pending=records.filter(x=>!processed.has(x.id));\nif(!pending.length)return [];\npending.sort((a,b)=>b.completedMs-a.completedMs||a.id.localeCompare(b.id));\nreturn [{json:{promptId:pending[0].id,completedAt:pending[0].completedMs,readyToFree:true}}];"
      }
    },
    {
      "id": "cleanup",
      "name": "Unload models and free VRAM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8188/free",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"unload_models\":true,\"free_memory\":true}",
        "options": {}
      }
    },
    {
      "id": "delay",
      "name": "Wait for VRAM cleanup",
      "webhookId": "f9159778-3231-4b84-a29e-85e6b185cd71",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "seconds"
      }
    },
    {
      "id": "stats",
