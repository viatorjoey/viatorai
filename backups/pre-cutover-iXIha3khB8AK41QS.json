{
  "id": "iXIha3khB8AK41QS",
  "versionId": "526c3960-3740-4420-a0b6-1747349d7dcd",
  "active": false,
  "name": "AI Creator Studio - LTX 2.3+2.5 완료 후 안전 VRAM 정리 v2",
  "nodes": [
    {
      "id": "watch-trigger",
      "name": "Check every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "history",
      "name": "Recent LTX History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        300
      ],
      "parameters": {
        "url": "http://host.docker.internal:8188/history?max_items=20",
        "options": {}
      }
    },
    {
      "id": "queue",
      "name": "Current ComfyUI Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        300
      ],
      "parameters": {
        "url": "http://host.docker.internal:8188/queue",
        "options": {}
      }
