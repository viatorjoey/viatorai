    {
      "id": "check-idle",
      "name": "Double-check ComfyUI Queue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "url": "http://host.docker.internal:8188/queue",
        "options": {}
      }
    },
    {
      "id": "queue-guard",
      "name": "Queue still empty?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1520,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 3,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "idle-v2",
              "leftValue": "={{ Array.isArray($json.queue_running) && Array.isArray($json.queue_pending) && $json.queue_running.length === 0 && $json.queue_pending.length === 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "mark-completed",
      "name": "Mark exact prompt ID processed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1740,
        210
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const state=$getWorkflowStaticData('global');\nconst id=$('Detect newly completed LTX video').first().json.promptId;\nif(!id)throw new Error('Missing prompt ID');\nconst ids=Array.isArray(state.processedIds)?state.processedIds:[];\nstate.processedIds=[...new Set([...ids,id])].slice(-200);\nreturn [{json:{promptId:id,markedProcessed:true}}];"
      }
    }
  ],
